# Connection string for the application's own PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Local timezone. Governs what "today" means for due dates and projections.
TZ="UTC"

# Port inside the container.
PORT=3000

# File ownership for the data volume. Unraid defaults.
PUID=99
PGID=100

# Where uploads and backups are written.
DATA_DIR=/app/data

# This application has no authentication of its own. It expects to sit behind an
# authenticating reverse proxy and to be reachable ONLY through it — see the
# security section of the README. Do not publish its port to an untrusted
# network.

# Day of the month the planning split falls on. Changeable in the app later.
DEFAULT_SPLIT_DAY=15

# Days the cash projection looks ahead.
DEFAULT_HORIZON_DAYS=45

# How many months back an unpaid bill still counts as owed. Changeable in the
# app; a longer window mostly surfaces gaps in the record rather than real debts.
DEFAULT_CARRY_MONTHS=1

