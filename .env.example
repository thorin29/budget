# Connection string for the application's own PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Local timezone. Governs what "today" means for due dates and projections.
TZ="UTC"

# Port inside the container.
PORT=3000

# File ownership for the data volume. Unraid defaults.
PUID=99
PGID=100

# Where uploads and backups are written.
DATA_DIR=/app/data

# Optional. The header your reverse proxy puts the real client IP in, used for
# rate limits. Without it: cf-connecting-ip, then x-forwarded-for.
REAL_IP_HEADER=

# Optional. Overrides the cookie-signing secret, which is otherwise minted into
# the database on first run. At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=

# Optional. Origins allowed to embed the app in a frame, space-separated, e.g.
# "https://dashboard.example.com". Empty keeps framing to the app's own origin.
FRAME_ANCESTORS=

# Day of the month the planning split falls on. Changeable in the app later.
DEFAULT_SPLIT_DAY=15

# Days the cash projection looks ahead.
DEFAULT_HORIZON_DAYS=45

# How many months back an unpaid bill still counts as owed. Changeable in the
# app; a longer window mostly surfaces gaps in the record rather than real debts.
DEFAULT_CARRY_MONTHS=1


# ---- Bank sync (optional) ----------------------------------------------------
# Encrypts the bank-feed access link in the database. Any random string of at
# least 32 characters, e.g. `openssl rand -base64 48`. Without it, bank sync
# stays off. Keep a copy: changing it means connecting again.
BANK_SYNC_KEY=

# Local hour (0-23) after which the daily sync runs.
BANK_SYNC_HOUR=6

# Extra SimpleFIN-compatible hosts to allow, comma-separated. The SimpleFIN
# Bridge hosts are always allowed.
SIMPLEFIN_EXTRA_HOSTS=

# "off" stops the automatic daily sync; Sync now in Settings still works.
BANK_SYNC_SCHEDULER=
